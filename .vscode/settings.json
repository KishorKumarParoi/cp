    "/^python3 -m py_compile scripts/watch_and_stage\\.py && git diff --no-index -- /dev/null scripts/watch_and_stage\\.py \\|\\| true$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^diff -u template\\.cpp B_Stakes_and_Shapes\\.cpp \\|\\| true; printf '\\\\n-- template bytes --\\\\n'; tail -c 20 template\\.cpp \\| od -An -t x1; printf '\\\\n-- target bytes --\\\\n'; tail -c 20 B_Stakes_and_Shapes\\.cpp \\| od -An -t x1$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^python3 scripts/watch_and_stage\\.py --interval 0\\.2$/": {
